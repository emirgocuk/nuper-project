{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuper Citadel",
  "version": "1.0.0",
  "identifier": "com.nuper.citadel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nuper Citadel - Savunma Sanayii Kalifikasyon & Pre-FEA İstasyonu",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:8765 http://127.0.0.1:11434 blob: data:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Nuper Citadel Air-Gapped Savunma İstasyonu"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
