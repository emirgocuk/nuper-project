{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DrawingExtractionResult",
  "type": "object",
  "required": ["success", "filename", "title_block", "datums", "dimensions"],
  "properties": {
    "success": { "type": "boolean" },
    "error": { "type": "string" },
    "filename": { "type": "string" },
    "page_count": { "type": "integer" },
    "raw_text_length": { "type": "integer" },
    "title_block": {
      "type": "object",
      "required": ["part_number", "material", "hardness", "roughness", "general_tolerance", "drawing_number"],
      "properties": {
        "part_number": { "type": "string" },
        "material": { "type": "string" },
        "hardness": { "type": "string" },
        "roughness": { "type": "string" },
        "general_tolerance": { "type": "string" },
        "drawing_number": { "type": "string" }
      }
    },
    "datums": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "image_data"],
        "properties": {
          "page": { "type": "integer" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "image_data": { "type": "string" }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "balloon", "type", "type_label", "nominal", "nominal_str", "upper_tol", "lower_tol", "measured", "deviation", "status"],
        "properties": {
          "id": { "type": "integer" },
          "balloon": { "type": "string" },
          "page": { "type": "integer" },
          "page_number": { "type": "integer" },
          "datum_reference": { "type": "string" },
          "type": { "type": "string" },
          "type_label": { "type": "string" },
          "icon": { "type": "string" },
          "nominal": { "type": "number" },
          "nominal_str": { "type": "string" },
          "upper_tol": { "type": "string" },
          "lower_tol": { "type": "string" },
          "measured": { "type": "string" },
          "deviation": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PASS", "WARN", "FAIL", "UNMEASURED"],
            "default": "UNMEASURED"
          },
          "verification": {
            "type": "string",
            "enum": ["RAW", "PARSED", "DUAL_VERIFIED", "CAD_VERIFIED", "HUMAN_VERIFIED", "NEEDS_REVIEW", "CONFLICT", "UNVERIFIED"],
            "default": "PARSED"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source_sha256": { "type": "string" },
              "page": { "type": "integer" },
              "bbox": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4
              },
              "method": { "type": "string" },
              "extractor_version": { "type": "string" }
            }
          },
          "feature_key": { "type": "string" },
          "gdt": { "type": "string" },
          "op": { "type": "string" },
          "op_reason": { "type": "string" },
          "risk_level": {
            "type": "string",
            "enum": ["NORMAL", "WARNING", "CRITICAL"],
            "default": "NORMAL"
          },
          "risk_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tolerance_source": {
            "type": "string",
            "default": "EXPLICIT"
          },
          "view_name": {
            "type": "string"
          },
          "inferred_axis": {
            "type": "string",
            "enum": ["X", "Y", "Z", "RADIAL", "UNKNOWN"]
          },
          "attachment_points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" }
            }
          },
          "rel_position": {
            "type": "array",
            "items": { "type": "number" }
          },
          "match_confidence": {
            "type": "number",
            "default": 0.0
          },
          "match_status": {
            "type": "string",
            "enum": ["AP242_NATIVE_PMI", "VERIFIED_EXACT", "VERIFIED_TOPOLOGY", "ENGINEER_LOCKED", "NEEDS_REVIEW", "UNMATCHED"]
          },
          "matched_face_ids": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "distance_type": { "type": "string" },
          "faceA_center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "faceB_center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "faceA_normal": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "faceB_normal": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "similar_parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_id": { "type": "string" },
          "part_name": { "type": "string" },
          "similarity_score": { "type": "number" },
          "recommended_setup_op10": { "type": "string" },
          "recommended_probe": { "type": "string" }
        }
      }
    },
    "contract_summary": {
      "type": "object",
      "properties": {
        "critical_count": { "type": "integer" },
        "warning_count": { "type": "integer" },
        "min_tolerance_mm": { "type": "number" },
        "requires_special_probing": { "type": "boolean" }
      }
    }
  }
}
