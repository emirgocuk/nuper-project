{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InspectionPlanPayload",
  "type": "object",
  "required": ["plan_id", "part_number", "items", "audit_hash"],
  "properties": {
    "plan_id": { "type": "string" },
    "created_at": { "type": "string" },
    "part_number": { "type": "string" },
    "cad_reference": { "type": "string" },
    "drawing_reference": { "type": "string" },
    "audit_hash": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "order", "type", "priority", "status"],
        "properties": {
          "order": { "type": "integer" },
          "item_id": { "type": "string" },
          "feature_id": { "type": "string" },
          "balloon_id": { "type": "integer" },
          "type": {
            "type": "string",
            "enum": ["DATUM_PRIMARY", "DATUM_SECONDARY", "DATUM_TERTIARY", "GEOMETRIC_TOL", "LINEAR_DIM"]
          },
          "datum_reference": {
            "type": "array",
            "items": { "type": "string" }
          },
          "priority": {
            "type": "string",
            "enum": ["MANDATORY", "STANDARD", "LEAN_FILTERED"]
          },
          "feature_key": { "type": "string" },
          "characteristic": { "type": "string" },
          "nominal": { "type": "number" },
          "nominal_str": { "type": "string" },
          "upper_tol": { "type": "number" },
          "lower_tol": { "type": "number" },
          "measured": { "type": "number" },
          "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "SUSPECT", "PENDING"] },
          "op": { "type": "string" },
          "op_reason": { "type": "string" },
          "operator_approved": { "type": "boolean" },
          "approval_timestamp": { "type": "string" }
        }
      }
    }
  }
}
